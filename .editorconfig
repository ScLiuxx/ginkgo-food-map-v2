root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[{*.yml,*.yaml,*.json}]
indent_style = space
indent_size = 2

# Windows PowerShell 5通过BOM识别中文脚本，避免按本机ANSI编码解析。
[deploy/monitoring/Start-GrafanaLocal.ps1]
charset = utf-8-bom
