<view class="page tab-page home-page">
  <view class="ambient">
    <view class="ambient-blob ambient-a"></view>
    <view class="ambient-blob ambient-b"></view>
    <view class="ambient-blob ambient-c"></view>
  </view>

  <view class="home-head">
    <view class="brand-row">
      <view class="brand-mark">G</view>
      <view class="flex-1">
        <view class="brand-name">泥电美食地图</view>
        <view class="brand-sub">校园美食评价社区</view>
      </view>
      <view wx:if="{{!loggedIn}}" class="login-chip" bindtap="onLoginTap">登录</view>
    </view>

    <view class="search-box">
      <input
        class="search-input"
        type="text"
        confirm-type="search"
        placeholder="搜索店名、地址、分类或标签"
        placeholder-class="search-placeholder"
        maxlength="100"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearchConfirm"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">×</view>
      <view class="search-action" bindtap="onSearchConfirm">搜索</view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view
      class="category-chip {{activeCategory === '' ? 'active' : ''}}"
      data-code=""
      bindtap="onCategoryTap"
    >全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="code"
      class="category-chip {{activeCategory === item.code ? 'active' : ''}}"
      data-code="{{item.code}}"
      bindtap="onCategoryTap"
    >{{item.name}}</view>
  </scroll-view>

  <view class="filter-bar">
    <view class="filter-toggle {{filterOpen ? 'active' : ''}}" bindtap="toggleFilters">
      筛选{{activeFilterCount ? ' · ' + activeFilterCount : ''}} ▾
    </view>
    <view class="filter-closed {{hideClosed ? 'active' : ''}}" bindtap="toggleHideClosed">
      隐藏停业
    </view>
    <view class="random-entry" bindtap="openRandom">帮我选一家</view>
  </view>

  <view wx:if="{{filterOpen}}" class="filter-panel">
    <picker mode="selector" range="{{maxPriceLabels}}" value="{{maxPriceIndex}}" bindchange="onPriceChange">
      <view class="filter-select">人均：{{maxPriceLabels[maxPriceIndex]}} ▾</view>
    </picker>
    <picker mode="selector" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="filter-select">类型：{{typeLabels[typeIndex]}} ▾</view>
    </picker>
    <picker mode="selector" range="{{diningLabels}}" value="{{diningIndex}}" bindchange="onDiningChange">
      <view class="filter-select">方式：{{diningLabels[diningIndex]}} ▾</view>
    </picker>
    <picker mode="selector" range="{{distanceLabels}}" value="{{distanceIndex}}" bindchange="onDistanceChange">
      <view class="filter-select">距离：{{distanceLabels[distanceIndex]}} ▾</view>
    </picker>
    <view
      class="filter-select filter-check {{hasReviews ? 'active' : ''}}"
      bindtap="toggleHasReviews"
    >{{hasReviews ? '✓ 只看有点评' : '只看有点评'}}</view>
    <view class="filter-reset" bindtap="resetFilters">重置</view>
  </view>

  <view class="ranking-entry" bindtap="openRankings">
    <view class="ranking-entry-copy">
      <view class="ranking-entry-title">近期推荐榜</view>
      <view class="ranking-entry-sub">清水河 / 沙河 · 近 7 天或 30 天</view>
    </view>
    <view class="ranking-entry-arrow">查看 ›</view>
  </view>

  <view class="result-bar">
    <view class="result-count">共 {{total}} 家</view>
    <view class="result-actions">
      <view class="add-shop" bindtap="openSubmission">＋ 添加店铺</view>
      <picker mode="selector" range="{{sortLabels}}" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="sort-picker">{{sortLabels[sortIndex]}} ▾</view>
      </picker>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty-state">正在加载店铺…</view>
  <view wx:elif="{{errorMessage}}" class="empty-state">
    <view class="error-text">{{errorMessage}}</view>
    <view class="ghost-button retry-button" bindtap="onRetry">重新加载</view>
  </view>
  <view wx:elif="{{!records.length}}" class="empty-state">
    没有找到符合条件的店铺，试试更换关键词或分类。
  </view>
  <view wx:else class="restaurant-list">
    <view
      wx:for="{{records}}"
      wx:key="id"
      class="restaurant-row"
      hover-class="card-press"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="onRestaurantTap"
    >
      <view class="restaurant-cover">
        <image
          wx:if="{{item.coverUrl}}"
          class="cover-image"
          src="{{item.coverUrl}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:else class="cover-placeholder">暂无图片</view>
        <view wx:if="{{item.closed}}" class="closed-badge">停业</view>
      </view>

      <view class="restaurant-copy">
        <view class="restaurant-name">{{item.name}}</view>
        <view class="rating-line">
          <text class="score">{{item.scoreText}}</text>
          <text class="rating-note">{{item.reviewCountText}}</text>
          <text class="price">{{item.priceText}}</text>
        </view>
        <view class="meta-line">
          <text class="category">{{item.categoryLabel}}</text>
          <text wx:if="{{item.supportsText}}" class="meta-dot">·</text>
          <text wx:if="{{item.supportsText}}" class="meta">{{item.supportsText}}</text>
          <text wx:if="{{item.distanceText}}" class="meta-dot">·</text>
          <text wx:if="{{item.distanceText}}" class="meta">{{item.distanceText}}</text>
        </view>
        <view class="address-line">{{item.addressText}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="load-more">正在加载更多…</view>
  <view wx:elif="{{!loading && records.length && !hasMore}}" class="load-more">
    已展示当前可浏览范围
  </view>

  <view class="home-footer">泥电美食地图 · 校园美食评价社区</view>

  <view wx:if="{{randomVisible}}" class="random-mask" bindtap="closeRandom">
    <view class="random-card" catchtap="stopPropagation">
      <view class="random-head">
        <view class="random-title">今天吃什么</view>
        <view class="random-close" bindtap="closeRandom">×</view>
      </view>
      <view class="random-filters">
        <picker
          mode="selector"
          range="{{randomRangeLabels}}"
          value="{{randomRangeIndex}}"
          bindchange="onRandomRangeChange"
        >
          <view class="random-budget">范围：{{randomRangeLabels[randomRangeIndex]}} ▾</view>
        </picker>
        <picker
          mode="selector"
          range="{{randomDistanceLabels}}"
          value="{{randomDistanceIndex}}"
          bindchange="onRandomDistanceChange"
        >
          <view class="random-budget">距离：{{randomDistanceLabels[randomDistanceIndex]}} ▾</view>
        </picker>
        <picker
          mode="selector"
          range="{{randomBudgetLabels}}"
          value="{{randomBudgetIndex}}"
          bindchange="onRandomBudgetChange"
        >
          <view class="random-budget">人均：{{randomBudgetLabels[randomBudgetIndex]}} ▾</view>
        </picker>
        <picker
          mode="selector"
          range="{{randomRatingLabels}}"
          value="{{randomRatingIndex}}"
          bindchange="onRandomRatingChange"
        >
          <view class="random-budget">评分：{{randomRatingLabels[randomRatingIndex]}} ▾</view>
        </picker>
        <picker
          mode="selector"
          range="{{randomCategoryLabels}}"
          value="{{randomCategoryIndex}}"
          bindchange="onRandomCategoryChange"
        >
          <view class="random-budget">分类：{{randomCategoryLabels[randomCategoryIndex]}} ▾</view>
        </picker>
        <picker
          mode="selector"
          range="{{randomDiningLabels}}"
          value="{{randomDiningIndex}}"
          bindchange="onRandomDiningChange"
        >
          <view class="random-budget">方式：{{randomDiningLabels[randomDiningIndex]}} ▾</view>
        </picker>
      </view>
      <view class="random-note">仅随机普通餐厅；条件由服务端实时筛选，不沿用首页关键词。</view>
      <view wx:if="{{randomLoading}}" class="random-status">正在从符合条件的店铺中选择…</view>
      <view wx:elif="{{randomError}}" class="random-status error-text">{{randomError}}</view>
      <view wx:elif="{{randomResult}}" class="random-result">
        <view class="random-count">
          符合条件 {{randomCandidateCount}} 家
          <text wx:if="{{randomRemainingCount}}">· 剩余 {{randomRemainingCount}} 家未看</text>
        </view>
        <view class="random-name">{{randomResult.name}}</view>
        <view class="random-meta">
          {{randomResult.categoryLabel}} · {{randomResult.priceText}} · {{randomResult.scoreText}}
        </view>
        <view class="random-address">{{randomResult.addressText}}</view>
        <view class="random-actions">
          <view class="random-primary" bindtap="openRandomResult">查看详情</view>
          <view wx:if="{{randomPrevious}}" class="random-secondary" bindtap="previousRandom">
            上一家
          </view>
          <view class="random-secondary" bindtap="rerollRandom">换一家</view>
        </view>
      </view>
      <view wx:else class="random-status">没有符合条件的店铺，请放宽距离、预算或评分。</view>
      <view
        wx:if="{{!randomLoading && (randomError || !randomResult)}}"
        class="random-retry"
        bindtap="rerollRandom"
      >{{randomError ? '重试' : '再试一次'}}</view>
      <view class="random-restart" bindtap="restartRandom">重新开始本轮</view>
    </view>
  </view>
</view>
