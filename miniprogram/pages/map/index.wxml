<view class="map-page">
  <map
    id="restaurantMap"
    class="map-canvas"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location="{{showLocation}}"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  ></map>

  <view class="map-top">
    <view class="map-title-row">
      <view>
        <view class="map-title">地图找店</view>
        <view class="map-sub">{{located ? '已定位到当前位置' : '校园中心视野'}}</view>
      </view>
      <view wx:if="{{loading}}" class="map-loading">读取中…</view>
    </view>
    <view wx:if="{{locationHint}}" class="map-warn">{{locationHint}}</view>
    <view class="map-search-row">
      <input
        class="map-search-input"
        value="{{keyword}}"
        placeholder="搜索本站餐厅"
        placeholder-class="map-search-placeholder"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearchConfirm"
      />
      <view class="map-search-submit" bindtap="onSearchConfirm">搜索</view>
      <view wx:if="{{searchOpen}}" class="map-search-cancel" bindtap="clearSearch">取消</view>
    </view>
  </view>

  <view wx:if="{{searchOpen}}" class="search-panel">
    <view class="search-panel-head">
      <view class="search-panel-title">站内搜索结果</view>
      <view class="search-panel-count">{{searchTotal}} 家</view>
    </view>
    <view class="search-tip">仅搜索本站店铺；高德外部地点搜索仍仅在网页端提供。</view>
    <scroll-view class="search-results" scroll-y>
      <view wx:if="{{searchLoading}}" class="search-status">正在搜索…</view>
      <view wx:elif="{{searchError}}" class="search-status error-text">{{searchError}}</view>
      <view wx:elif="{{!searchResults.length}}" class="search-status">没有找到匹配的店铺。</view>
      <view
        wx:for="{{searchResults}}"
        wx:key="id"
        class="search-item"
        data-id="{{item.id}}"
        bindtap="openSearchResult"
      >
        <view class="search-name">{{item.name}}</view>
        <view class="search-meta">{{item.categoryLabel}} · {{item.priceText}} · {{item.scoreText}}</view>
        <view class="search-address">{{item.addressText}}</view>
      </view>
      <view wx:if="{{searchHasMore}}" class="search-more" bindtap="loadMoreSearch">
        {{searchMoreLoading ? '加载中…' : '加载更多'}}
      </view>
    </scroll-view>
  </view>

  <view class="map-sheet">
    <view class="map-count-row">
      <view class="map-count">{{matchedCount}}</view>
      <view class="map-count-copy">家店铺在当前范围</view>
    </view>
    <view class="map-sheet-copy">
      <text wx:if="{{truncated}}">点位较多，仅展示前 {{returnedCount}} 家，请放大地图查看更精确结果。</text>
      <text wx:else>拖动或缩放地图自动更新店铺；点击蓝色标记查看详情。</text>
    </view>
    <view wx:if="{{errorMessage}}" class="error-text map-error">{{errorMessage}}</view>
    <view class="map-actions">
      <view class="ghost-button map-action" bindtap="onLocateTap">
        {{locating ? '定位中…' : '回到我的位置'}}
      </view>
      <view class="ghost-button map-action" bindtap="retry">重新加载</view>
    </view>
  </view>
</view>
