.placeholder-hero {
  padding: 72rpx 20rpx 48rpx;
}

.placeholder-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  border: 1rpx solid #e4ddd1;
  border-radius: 32rpx;
  background: #fffdf8;
  color: #625c52;
  font-size: 26rpx;
  font-weight: 700;
}

.placeholder-title {
  font-size: 44rpx;
  font-weight: 800;
}

.placeholder-copy {
  margin-top: 16rpx;
  color: #7a7266;
  font-size: 26rpx;
  line-height: 1.8;
}

.planning-card {
  padding: 30rpx;
}

.planning-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 750;
}

.planning-item {
  padding: 8rpx 0;
  color: #625c52;
  font-size: 25rpx;
  line-height: 1.7;
}
