<view class="page login-page">
  <view class="login-hero">
    <view class="login-mark">G</view>
    <view class="login-title">登录泥电美食地图</view>
    <view class="login-subtitle">使用用户名或校园邮箱继续</view>
  </view>

  <view class="card login-card">
    <view class="field">
      <view class="field-label">用户名或邮箱</view>
      <input
        class="field-input"
        type="text"
        confirm-type="next"
        placeholder="请输入用户名或注册邮箱"
        placeholder-class="field-placeholder"
        maxlength="254"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="field">
      <view class="field-label">密码</view>
      <input
        class="field-input"
        type="text"
        password
        confirm-type="done"
        placeholder="请输入密码"
        placeholder-class="field-placeholder"
        maxlength="72"
        value="{{password}}"
        bindinput="onPasswordInput"
        bindconfirm="submit"
      />
    </view>

    <view wx:if="{{errorMessage}}" class="error-text login-error">{{errorMessage}}</view>

    <button
      class="primary-button login-button"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submit"
    >
      {{submitting ? '登录中…' : '登录'}}
    </button>
  </view>

  <view class="login-note">
    注册账号与找回密码需要校园邮箱验证码，暂未在小程序开放，请先在网页端完成。
  </view>
</view>
