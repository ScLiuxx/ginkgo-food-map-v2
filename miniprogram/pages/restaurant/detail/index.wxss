.detail-page {
  padding-top: 0;
}

.album-swiper {
  width: calc(100% + 56rpx);
  height: 420rpx;
  margin: 0 -28rpx 24rpx;
  background: #eeeae2;
}

.album-image {
  width: 100%;
  height: 100%;
  display: block;
}

.album-empty {
  width: calc(100% + 56rpx);
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 -28rpx 24rpx;
  background: #eeeae2;
  color: #a49b8e;
  font-size: 25rpx;
}

.album-more {
  margin: -10rpx 0 24rpx;
  color: #986d08;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

.summary-card {
  padding: 32rpx 28rpx;
}

.summary-top {
  display: flex;
  align-items: flex-start;
}

.detail-name {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.detail-sub {
  margin-top: 8rpx;
  color: #7a7266;
  font-size: 24rpx;
}

.favorite-button {
  flex: 0 0 auto;
  margin-left: 18rpx;
  padding: 12rpx 26rpx;
  border: 1rpx solid #e4ddd1;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #625c52;
  font-size: 24rpx;
  font-weight: 650;
}

.favorite-button.active {
  border-color: #e3b44b;
  background: #fdf3da;
  color: #8a5f03;
}

.favorite-hint {
  margin-top: 14rpx;
}

.summary-rating {
  display: flex;
  align-items: flex-end;
  margin-top: 26rpx;
}

.summary-score {
  margin-right: 18rpx;
  color: #ba5610;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-count {
  font-size: 25rpx;
  font-weight: 650;
}

.summary-meta {
  margin-top: 2rpx;
  font-size: 23rpx;
}

.summary-price {
  margin-left: auto;
  color: #2b2a26;
  font-size: 30rpx;
  font-weight: 700;
}

.dimension-grid {
  display: flex;
  margin-top: 26rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #faf8f3;
}

.dimension-item {
  flex: 1;
  text-align: center;
}

.dimension-value {
  font-size: 30rpx;
  font-weight: 750;
}

.dimension-label {
  margin-top: 2rpx;
  color: #8a8175;
  font-size: 22rpx;
}

.info-divider {
  margin: 22rpx 0 16rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  font-size: 25rpx;
}

.info-label {
  flex: 0 0 76rpx;
  color: #8a8175;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #3f3a33;
  overflow-wrap: anywhere;
}

.tag-row {
  margin-top: 16rpx;
}

.map-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f7f3ea;
  color: #8a8175;
  font-size: 22rpx;
  line-height: 1.6;
}

.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
}

.section-meta {
  margin-bottom: 16rpx;
  color: #8a8175;
  font-size: 23rpx;
}

.sort-picker {
  color: #625c52;
  font-size: 24rpx;
  font-weight: 600;
}

.window-card {
  padding: 8rpx 28rpx;
}

.window-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ece6dc;
}

.window-row:last-child {
  border-bottom: none;
}

.window-cover {
  flex: 0 0 108rpx;
  width: 108rpx;
  height: 108rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #eeeae2;
}

.window-image {
  width: 100%;
  height: 100%;
  display: block;
}

.window-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a49b8e;
  font-size: 21rpx;
}

.window-name {
  font-size: 28rpx;
  font-weight: 700;
}

.window-meta {
  margin-top: 2rpx;
  color: #7a7266;
  font-size: 23rpx;
}

.window-score {
  margin-top: 2rpx;
  color: #ba5610;
  font-size: 24rpx;
  font-weight: 700;
}

.window-closed {
  margin-left: 12rpx;
  color: #974e40;
  font-size: 22rpx;
}

.empty-window {
  color: #8a8175;
  font-size: 24rpx;
  text-align: center;
}

.review-list {
  margin-top: 4rpx;
}

.review-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.review-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #efe8db;
  color: #5f574a;
  font-size: 30rpx;
  font-weight: 750;
}

.review-author {
  font-size: 27rpx;
  font-weight: 700;
}

.author-level {
  color: #986d08;
  font-size: 22rpx;
  font-weight: 600;
}

.review-date {
  margin-top: 2rpx;
  color: #9a9184;
  font-size: 22rpx;
}

.review-score {
  margin-left: 14rpx;
  color: #ba5610;
  font-size: 38rpx;
  font-weight: 800;
}

.review-badge {
  display: inline-block;
  margin-top: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 650;
}

.review-badge.recommend {
  background: #e8f2ea;
  color: #2f6e4c;
}

.review-badge.avoid {
  background: #f7e9e6;
  color: #8b3f34;
}

.review-body {
  margin-top: 14rpx;
  color: #38342d;
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.review-photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.review-photo {
  width: 154rpx;
  height: 154rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  background: #eeeae2;
}

.retry-reviews {
  width: 240rpx;
  margin: 26rpx auto 0;
}

.load-more-reviews {
  width: 100%;
  margin-top: 8rpx;
}

.list-end {
  padding: 22rpx 0;
  color: #9a9184;
  font-size: 23rpx;
  text-align: center;
}

.compose-note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f7f3ea;
  color: #8a8175;
  font-size: 22rpx;
  text-align: center;
}

.detail-retry {
  width: 240rpx;
  margin: 28rpx auto 0;
}
