.detail-page {
  padding-top: 20rpx;
}

.album-swiper {
  width: 100%;
  height: 430rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 38rpx;
  overflow: hidden;
  background: rgba(214, 230, 242, 0.7);
  box-shadow: 0 24rpx 56rpx rgba(27, 63, 104, 0.16);
}

.album-image {
  width: 100%;
  height: 100%;
  display: block;
}

.album-empty {
  width: 100%;
  height: 250rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.32);
  color: var(--ink-muted);
  font-size: 25rpx;
}

.album-more {
  margin: -8rpx 0 24rpx;
  color: var(--accent-deep);
  font-size: 25rpx;
  font-weight: 650;
  text-align: center;
}

.summary-card {
  padding: 32rpx 28rpx;
}

.summary-top {
  display: flex;
  align-items: flex-start;
}

.detail-name {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.detail-sub {
  margin-top: 8rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
}

.favorite-button {
  flex: 0 0 auto;
  margin-left: 18rpx;
  padding: 14rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 650;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.favorite-button.active {
  border-color: rgba(255, 255, 255, 0.5);
  background: linear-gradient(135deg, #37a9ff, #0a84ff 58%, #0066cc);
  box-shadow: 0 10rpx 24rpx rgba(10, 132, 255, 0.26);
  color: #ffffff;
}

.favorite-hint {
  margin-top: 14rpx;
}

.summary-rating {
  display: flex;
  align-items: flex-end;
  margin-top: 26rpx;
}

.summary-score {
  margin-right: 18rpx;
  color: #c4680a;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-count {
  font-size: 25rpx;
  font-weight: 650;
}

.summary-meta {
  margin-top: 2rpx;
  font-size: 23rpx;
}

.summary-price {
  margin-left: auto;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.dimension-grid {
  display: flex;
  margin-top: 26rpx;
  padding: 20rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.3);
}

.dimension-item {
  flex: 1;
  text-align: center;
}

.dimension-value {
  font-size: 30rpx;
  font-weight: 750;
}

.dimension-label {
  margin-top: 2rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.info-divider {
  margin: 22rpx 0 16rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  font-size: 25rpx;
}

.info-label {
  flex: 0 0 76rpx;
  color: var(--ink-muted);
}

.info-value {
  flex: 1;
  min-width: 0;
  color: var(--ink-soft);
  overflow-wrap: anywhere;
}

.tag-row {
  margin-top: 16rpx;
}

.map-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.28);
  color: var(--ink-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
}

.section-meta {
  margin-bottom: 16rpx;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.sort-picker {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.window-card {
  padding: 8rpx 28rpx;
}

.window-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(8, 25, 43, 0.07);
}

.window-row:last-child {
  border-bottom: none;
}

.window-cover {
  flex: 0 0 108rpx;
  width: 108rpx;
  height: 108rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(210, 226, 240, 0.7);
}

.window-image {
  width: 100%;
  height: 100%;
  display: block;
}

.window-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-muted);
  font-size: 21rpx;
}

.window-name {
  font-size: 28rpx;
  font-weight: 700;
}

.window-meta {
  margin-top: 2rpx;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.window-score {
  margin-top: 2rpx;
  color: #c4680a;
  font-size: 24rpx;
  font-weight: 700;
}

.window-closed {
  margin-left: 12rpx;
  color: var(--danger);
  font-size: 22rpx;
}

.empty-window {
  color: var(--ink-muted);
  font-size: 24rpx;
  text-align: center;
}

.review-list {
  margin-top: 4rpx;
}

.review-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.review-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.8), rgba(172, 219, 255, 0.55));
  color: #0a6fbf;
  font-size: 30rpx;
  font-weight: 750;
}

.review-author {
  font-size: 27rpx;
  font-weight: 700;
}

.author-level {
  color: #a06a04;
  font-size: 22rpx;
  font-weight: 600;
}

.review-date {
  margin-top: 2rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.review-score {
  margin-left: 14rpx;
  color: #c4680a;
  font-size: 38rpx;
  font-weight: 800;
}

.review-badge {
  display: inline-block;
  margin-top: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 650;
}

.review-badge.recommend {
  background: rgba(52, 199, 89, 0.14);
  color: #1f7a45;
}

.review-badge.avoid {
  background: rgba(255, 59, 48, 0.12);
  color: #a1322a;
}

.review-body {
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.review-photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.review-photo {
  width: 154rpx;
  height: 154rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 18rpx;
  background: rgba(210, 226, 240, 0.7);
}

.retry-reviews {
  width: 240rpx;
  margin: 26rpx auto 0;
}

.load-more-reviews {
  width: 100%;
  margin-top: 8rpx;
}

.list-end {
  padding: 22rpx 0;
  color: var(--ink-muted);
  font-size: 23rpx;
  text-align: center;
}

.compose-note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.28);
  color: var(--ink-muted);
  font-size: 22rpx;
  text-align: center;
}

.detail-retry {
  width: 240rpx;
  margin: 28rpx auto 0;
}
