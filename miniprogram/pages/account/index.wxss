.account-page {
  padding-top: 36rpx;
}

.account-hero {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--glass-line);
  border-radius: 36rpx;
  background: var(--glass);
  box-shadow: var(--glass-shadow), var(--glass-inset);
  backdrop-filter: blur(18px) saturate(165%);
  -webkit-backdrop-filter: blur(18px) saturate(165%);
}

.account-avatar {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 36rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.8), rgba(163, 216, 255, 0.55));
  box-shadow: 0 16rpx 34rpx rgba(27, 63, 104, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  color: #0a6fbf;
  font-size: 48rpx;
  font-weight: 800;
}

.account-name {
  font-size: 38rpx;
  font-weight: 800;
}

.account-sub {
  margin-top: 6rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
}

.account-card {
  padding: 34rpx 30rpx;
}

.account-title {
  font-size: 30rpx;
  font-weight: 750;
}

.account-copy-text {
  margin: 12rpx 0 26rpx;
  color: var(--ink-muted);
  font-size: 25rpx;
  line-height: 1.8;
}

.logout-button {
  width: 100%;
}

.account-note {
  margin-top: 28rpx;
  padding: 0 12rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  line-height: 1.8;
}
