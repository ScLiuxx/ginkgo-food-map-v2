.placeholder-hero {
  padding: 72rpx 20rpx 40rpx;
}

.placeholder-icon {
  width: 124rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 36rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.76), rgba(163, 216, 255, 0.5));
  box-shadow: 0 18rpx 40rpx rgba(27, 63, 104, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  color: #0a6fbf;
  font-size: 26rpx;
  font-weight: 700;
}

.placeholder-title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.placeholder-copy {
  margin-top: 16rpx;
  color: var(--ink-muted);
  font-size: 26rpx;
  line-height: 1.8;
}

.login-title {
  font-size: 30rpx;
  font-weight: 750;
}

.login-copy {
  margin: 10rpx 0 26rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.planning-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 750;
}

.planning-item {
  padding: 8rpx 0;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
}
