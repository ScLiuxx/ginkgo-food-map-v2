.tabbar {
  position: fixed;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 900;
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 22rpx 56rpx rgba(27, 63, 104, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
}

.tab-item {
  flex: 1;
  height: 100%;
}

.tab-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  border: 1rpx solid transparent;
  border-radius: 44rpx;
  transition: background-color 0.2s ease;
}

.tab-inner.active {
  border-color: rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.66);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  margin-top: 2rpx;
  color: #5f7183;
  font-size: 20rpx;
  font-weight: 600;
}

.tab-inner.active .tab-label {
  color: #0a84ff;
  font-weight: 750;
}
